*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.tmp/
tmp/

# IDEs y Editores
.vscode/
.idea/
*.swp
*.swo
.history/
.project
.settings/
.classpath

# Sistema
.DS_Store
Thumbs.db
